From: NestBox
Subject: [PATCH] Android: resolve global Vulkan entry points through vkGetInstanceProcAddr

Android loaders may expose global Vulkan commands through vkGetInstanceProcAddr
without returning all of them from dlsym. The loader contract permits querying
global commands with a null VkInstance. Gfxstream already resolves
vkGetInstanceProcAddr first; use it as a fallback for the three missing
VK_VERSION_1_0 global commands before validating the dispatch table.

diff --git a/host/vulkan/cereal/common/goldfish_vk_dispatch.cpp b/host/vulkan/cereal/common/goldfish_vk_dispatch.cpp
--- a/host/vulkan/cereal/common/goldfish_vk_dispatch.cpp
+++ b/host/vulkan/cereal/common/goldfish_vk_dispatch.cpp
@@ -258,17 +258,34 @@
     out->vkGetInstanceProcAddr = (PFN_vkGetInstanceProcAddr)dlSymFunc(lib, "vkGetInstanceProcAddr");
     out->vkCreateDevice = (PFN_vkCreateDevice)dlSymFunc(lib, "vkCreateDevice");
     out->vkDestroyDevice = (PFN_vkDestroyDevice)dlSymFunc(lib, "vkDestroyDevice");
     out->vkEnumerateDeviceExtensionProperties = (PFN_vkEnumerateDeviceExtensionProperties)dlSymFunc(
         lib, "vkEnumerateDeviceExtensionProperties");
     out->vkEnumerateDeviceLayerProperties =
         (PFN_vkEnumerateDeviceLayerProperties)dlSymFunc(lib, "vkEnumerateDeviceLayerProperties");
     out->vkCreateInstance = (PFN_vkCreateInstance)dlSymFunc(lib, "vkCreateInstance");
     out->vkEnumerateInstanceExtensionProperties =
         (PFN_vkEnumerateInstanceExtensionProperties)dlSymFunc(
             lib, "vkEnumerateInstanceExtensionProperties");
     out->vkEnumerateInstanceLayerProperties = (PFN_vkEnumerateInstanceLayerProperties)dlSymFunc(
         lib, "vkEnumerateInstanceLayerProperties");
     out->vkGetDeviceProcAddr = (PFN_vkGetDeviceProcAddr)dlSymFunc(lib, "vkGetDeviceProcAddr");
     out->vkGetPhysicalDeviceSparseImageFormatProperties =
         (PFN_vkGetPhysicalDeviceSparseImageFormatProperties)dlSymFunc(
             lib, "vkGetPhysicalDeviceSparseImageFormatProperties");
+
+    // Android's loader can provide global entry points through GIPA even
+    // when dlsym() does not expose the individual trampoline symbols.
+    // Vulkan specifies VK_NULL_HANDLE for global-command lookups.
+    if (out->vkGetInstanceProcAddr) {
+        if (!out->vkCreateInstance)
+            out->vkCreateInstance = (PFN_vkCreateInstance)out->vkGetInstanceProcAddr(
+                VK_NULL_HANDLE, "vkCreateInstance");
+        if (!out->vkEnumerateInstanceExtensionProperties)
+            out->vkEnumerateInstanceExtensionProperties =
+                (PFN_vkEnumerateInstanceExtensionProperties)out->vkGetInstanceProcAddr(
+                    VK_NULL_HANDLE, "vkEnumerateInstanceExtensionProperties");
+        if (!out->vkEnumerateInstanceLayerProperties)
+            out->vkEnumerateInstanceLayerProperties =
+                (PFN_vkEnumerateInstanceLayerProperties)out->vkGetInstanceProcAddr(
+                    VK_NULL_HANDLE, "vkEnumerateInstanceLayerProperties");
+    }
